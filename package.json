{
  "name": "yawachat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proto": "vite --mode proto",
    "build": "tsc --noEmit && node scripts/clean-dist.mjs && vite build -c vite.app.config.ts && vite build -c vite.overlay.config.ts && vite build -c vite.widget.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bridge": "npm --prefix tiktok-bridge test",
    "test:release": "node --test scripts/release-plan.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:release",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "lucide-react": "^1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "source-map-js": ">=1.2.2",
    "minimatch": "^11.0.4"
  }
}
